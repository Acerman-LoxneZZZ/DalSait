      "refersTo": "button-paper",
      "description": "Light call to action over photography or pine.",
      "html": "<button class=\"ds-paper\">Начать свою историю<span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16M14 6l6 6-6 6\"/></svg></span></button>",
      "css": ".ds-paper{display:inline-flex;gap:32px;align-items:center;padding:9px 10px 9px 25px;border:0;border-radius:40px;background:var(--paper,#f4f1e8);color:var(--pine,#183d35);font:600 12px Manrope,sans-serif;cursor:pointer;transition:transform .35s var(--ease,cubic-bezier(.16,1,.3,1)),background .3s}.ds-paper span{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--pine,#183d35);color:var(--paper,#f4f1e8);transition:transform .4s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-paper svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-paper:hover{transform:translateY(-3px)}.ds-paper:hover span{transform:rotate(45deg)}.ds-paper:focus-visible{outline:3px solid var(--orange,#b65131);outline-offset:6px}"
    },
