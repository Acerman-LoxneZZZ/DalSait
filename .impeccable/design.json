  "narrative": {
    "northStar": "The Independent Travel Field Journal",
    "overview": "Photographic landscapes lead; warm paper gives each pause the feel of a personal travel journal. Pine grounds the immersive scenes and closing surface, while orange marks routes and expressive italic phrases. The density alternates between expansive imagery and compact, carefully spaced editorial details.\n\nMotion follows exploration: prints rotate along a shared arc, an itinerary fills as it is read, and photographs lift when touched. Cyrillic serif headlines carry emotion; sans-serif copy keeps destinations and controls legible. These rules describe the shipped HTML, stylesheet and interactions rather than a prospective component library.",
    "keyCharacteristics": [
      "Scenic photography with restrained dark shading.",
      "Expressive serif titles and precise sans-serif details.",
      "Warm paper, pine anchors and orange route marks.",
      "Physical photographic prints with gentle rotation and diffuse depth.",
      "Scroll-linked exploration with reduced-motion alternatives."
    ],
    "rules": [
      {
        "name": "The Route Mark Rule",
        "body": "Use orange for reading progress, itinerary states, focus and editorial emphasis; preserve pine and paper as the broad surfaces.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use the serif for expressive titles and personal captions; use Manrope for prose, controls and factual metadata.",
        "section": "typography"
      },
      {
        "name": "The Photographic Depth Rule",
        "body": "Attach diffuse elevation to mounted photographs and dialogs; leave ordinary reading surfaces flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let photographic landscapes set the atmosphere, with shading where text overlays them.",
      "Do use the serif for expressive titles and the sans-serif for prose and controls.",
      "Do keep orange connected to emphasis, route progress and visible focus.",
      "Do preserve the shared arc geometry, paper print margins and mobile reading order.",
      "Do provide pause controls and honor reduced-motion preferences."
    ],
    "donts": [
      "Don't turn the warm reading surfaces into a grid of raised containers.",
      "Don't replace SVG controls with text glyph icons.",
      "Don't add invented kickers above section headings.",
      "Don't introduce hard offset shadows into this diffuse photographic world."
    ]
  }
}
