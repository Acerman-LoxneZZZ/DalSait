      "css": ".ds-round{width:43px;height:43px;display:grid;place-items:center;border:1px solid #9da99b;background:transparent;color:var(--ink,#203c34);border-radius:50%;cursor:pointer;transition:background .25s,color .25s,transform .3s}.ds-round svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-round:hover{background:var(--pine,#183d35);color:var(--paper,#f4f1e8);transform:scale(1.06)}.ds-round:focus-visible{outline:3px solid var(--orange,#b65131);outline-offset:6px}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "Quiet continuation beneath editorial text.",
      "html": "<button class=\"ds-text\">Ещё одна история <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16M14 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-text{display:inline-flex;gap:30px;align-items:center;background:none;color:var(--ink,#203c34);padding:0 0 8px;border:0;border-bottom:1px solid #9ba99d;font:11px Manrope,sans-serif;cursor:pointer;transition:gap .3s}.ds-text svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-text:hover{gap:43px}.ds-text:focus-visible{outline:3px solid var(--orange,#b65131);outline-offset:6px}"
    },
