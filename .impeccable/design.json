      "css": ".ds-print{width:254px;height:330px;padding:9px 9px 13px;background:var(--print-paper,#faf9f3);color:var(--ink,#203c34);border:0;border-radius:8px;box-shadow:0 14px 24px -14px #25382c55;text-align:left;cursor:pointer;transition:box-shadow .4s}.ds-print>svg{display:block;width:100%;height:251px;border-radius:4px;transition:filter .5s,transform .5s}.ds-print>span{display:flex;flex-direction:column;padding:9px 5px 0}.ds-print strong{font:500 13px Manrope,sans-serif}.ds-print small{font:11px Manrope,sans-serif;color:var(--muted,#526359)}.ds-print:hover{box-shadow:0 24px 40px -15px #25382c75}.ds-print:hover>svg{filter:saturate(1.1);transform:scale(1.025)}.ds-print:focus-visible{outline:3px solid var(--orange,#b65131);outline-offset:6px}"
